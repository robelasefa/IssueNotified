# Telegram Bot Configuration
BOT_TOKEN=YOUR_TELEGRAM_TOKEN
DEV_BOT_TOKEN=YOUR_DEV_TELEGRAM_TOKEN
ADMIN_USER_ID=0

# GitHub API Configuration
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Webhook Configuration
WEBHOOK_BASE_URL=https://your-app-name-suffix.region.azurewebsites.net
# Shared secret for GitHub webhook HMAC validation (auto-generated if not set)
WEBHOOK_SECRET=
# Server port (Azure sets PORT automatically)
PORT=8443

# Optional Settings
DEBUG=false
