# Telegram Bot Configuration
BOT_TOKEN=YOUR_TELEGRAM_TOKEN
DEV_BOT_TOKEN=YOUR_DEV_TELEGRAM_TOKEN
ADMIN_USER_ID=0

# GitHub API Configuration
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Webhook Configuration
# Public HTTPS URL where this server is reachable (e.g. https://your-app.onrender.com)
WEBHOOK_BASE_URL=https://your-app-name.herokuapp.com
# Shared secret for GitHub webhook HMAC validation (auto-generated if not set)
WEBHOOK_SECRET=
# Server port (Heroku sets PORT automatically)
PORT=8443

# Optional Settings
DEBUG=false
